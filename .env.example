# Copy this file to ".env" and fill in your key.

# Optional: Gemini API key (https://aistudio.google.com/api-keys). A key saved in the dashboard is used first.
GEMINI_API_KEY=

# Model that turns the audio into English or Bangla text.
TRANSCRIBE_MODEL=gemini-3.5-transcribe

# Model that compares the transcript with the script and writes the report.
ANALYSIS_MODEL=gemini-3.5-flash-lite

# Server port
PORT=3000

# Max upload size in MB
MAX_UPLOAD_MB=200

# Optional: path to your own ffmpeg. Leave empty to use the bundled one.
FFMPEG_PATH=

# Password for the admin dashboard (/admin). Required to add scripts.
ADMIN_PASSWORD=

# MySQL / MariaDB / TiDB Cloud. These are the XAMPP defaults. The database is created automatically.
# For TiDB Cloud use its host, port 4000 and user (like abc123.root), or paste its connection
# string as DATABASE_URL instead. Encryption is switched on by itself for TiDB Cloud (DB_SSL=true forces it).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bp_management

# Optional: folder for videos and the saved API key. On Render, the mount path of a disk.
# STORAGE_DIR=/var/data
